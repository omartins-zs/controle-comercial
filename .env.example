# Copie este arquivo para ".env" e ajuste se necessário.
# Porta em que a aplicação ficará disponível no host: http://localhost:APP_PORT/
APP_PORT=8090

# URL base usada pelo CodeIgniter (deve bater com a porta acima)
APP_BASE_URL=http://localhost:8090/

# Ambiente do CodeIgniter: development | testing | production
CI_ENV=development

# Credenciais do MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=blog_comercial
MYSQL_USER=blog_user
MYSQL_PASSWORD=blog_pass

# Porta do MySQL exposta no host (útil para conectar com um cliente externo)
DB_EXTERNAL_PORT=3307

# Porta do phpMyAdmin
PMA_PORT=8091
